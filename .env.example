# Backtest Reality Check — environment variables.
# Copy to `.env` and fill in. All are OPTIONAL for local dev; the app runs
# without them (Pro features just can't be unlocked/paid for).

# --- Licensing (Pro tier) --------------------------------------------------
# HMAC secret used to sign/verify license keys. MUST be set in production —
# otherwise a known dev secret is used and anyone could forge a key.
LICENSE_SECRET=change-me-to-a-long-random-string

# Optional: comma-separated literal keys that are always valid Pro (manual comps).
# LICENSE_KEYS=FRIEND-1,REVIEWER-2

# Optional: comma-separated license ids to reject even if otherwise valid.
# LICENSE_REVOKED=abc123,def456

# Optional: where webhook-issued keys are logged (best-effort JSON file).
# LICENSE_STORE=/var/data/license_store.json

# Admin token for manual key issuance via POST /api/license/issue.
# ADMIN_TOKEN=some-long-random-admin-token

# --- Payments --------------------------------------------------------------
# The hosted checkout link shown on the "Unlock Pro" screen.
# CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/...
# PRICE_LABEL=$29 one-time

# Lemon Squeezy webhook signing secret (Settings → Webhooks).
# LEMONSQUEEZY_WEBHOOK_SECRET=...

# Stripe webhook signing secret (Developers → Webhooks → your endpoint).
# STRIPE_WEBHOOK_SECRET=whsec_...
