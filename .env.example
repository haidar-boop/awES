# ─── Core ────────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to run in DEMO MODE (in-memory seed data, no DB needed).
DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (auth + storage) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=report-photos

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="PennyRadar <alerts@pennyradar.ca>"

# ─── Stripe (Pro tier) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_MONTHLY=price_...   # $7 CAD/month
STRIPE_PRICE_YEARLY=price_...    # $49 CAD/year

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET=generate-a-long-random-string

# ─── Rate limiting (Upstash Redis REST; falls back to in-memory if unset) ────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ─── Admin bootstrap (comma-separated emails granted admin on first login) ───
ADMIN_EMAILS=you@example.com

# ─── Analytics (optional; Plausible) ─────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pennyradar.ca
