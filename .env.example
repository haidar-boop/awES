# Backtest Reality Check — environment variables.
# Copy to `.env` (local) or set in your host's dashboard (Render → Environment).

# --- Accounts (Supabase) ---------------------------------------------------
# Required for sign-up / email verification / login. Create a free project at
# supabase.com, then Project Settings → API:
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# In Supabase: Authentication → keep "Confirm email" ON, and add your site URL
# under Authentication → URL Configuration (so the verification link returns
# users to your app).

# --- Payments --------------------------------------------------------------
# The hosted checkout link shown after login. Use the SAME email at checkout as
# the account (it's prefilled automatically).
CHECKOUT_URL=https://YOURSTORE.lemonsqueezy.com/checkout/...
PRICE_LABEL=$29 one-time
# Email prefill param: Lemon Squeezy = checkout[email] (default); Stripe Payment
# Links = prefilled_email.
# CHECKOUT_EMAIL_PARAM=checkout[email]

# Lemon Squeezy webhook signing secret (Settings → Webhooks). Point the webhook
# at https://YOURAPP/api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=...

# STRONGLY recommended on hosts with an ephemeral disk (e.g. Render free): lets
# the server confirm "has this email paid?" straight from Lemon Squeezy, so Pro
# survives restarts even if the local record is wiped.
# LEMONSQUEEZY_API_KEY=...
# LEMONSQUEEZY_STORE_ID=12345   # optional: restrict the lookup to your store

# Stripe alternative (instead of Lemon Squeezy):
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin / misc ----------------------------------------------------------
# Grant Pro to an email manually (comps/testing): POST /api/admin/grant with
# header X-Admin-Token.
# ADMIN_TOKEN=some-long-random-admin-token

# Signs the internal license records minted on purchase. Optional in the
# account-based flow (entitlement comes from the verified webhook / LS API).
# LICENSE_SECRET=change-me
# LICENSE_STORE=/var/data/license_store.json
